<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dc1.amber"
    android:versionCode="10"
    android:versionName="2.7">

    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- persistent: AmberService's two ContentObservers (warmth mirror +
         white-rebase) are the whole point of the app; a plain background
         service gets stopped ~60s after leaving foreground (verified live),
         killing them. Persistent system processes are exempt. -->
    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_amber"
        android:theme="@style/AmberTheme"
        android:persistent="true"
        android:allowBackup="false">

        <!-- Slider UI (also a launcher entry so it's findable) -->
        <activity
            android:name=".AmberSettingsActivity"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Long-lived mirror service: observes the setting, writes the LED -->
        <service
            android:name=".AmberService"
            android:exported="false" />

        <!-- Quick Settings tile -->
        <service
            android:name=".AmberTile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true"
            android:icon="@drawable/ic_amber">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Boot: ensure default amber value + start the mirror service -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
