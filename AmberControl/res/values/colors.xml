<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome palette for the DC-1's reflective panel: the OS forces grayscale,
  so every value here is a true gray. White is the panel's natural (unlit)
  state, so it is the ground; black ink carries the contrast.
-->
<resources>
    <color name="paper">#FFFFFFFF</color>
    <color name="ink">#FF000000</color>
    <!-- secondary text / de-emphasised affordances -->
    <color name="ink_muted">#FF5C5C5C</color>
    <!-- hairline rules -->
    <color name="rule">#FFD6D6D6</color>
    <!-- unfilled part of the slider track -->
    <color name="track_idle">#FFC9C9C9</color>
    <!-- outline of the secondary (save) chip -->
    <color name="edge_soft">#FF8C8C8C</color>
</resources>
