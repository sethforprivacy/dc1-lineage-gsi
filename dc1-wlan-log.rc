# DC-1: silence the MediaTek wlan driver INFO log flood.
#
# The stock vendor wlan driver ships with dbgLevel 0x2f (ERROR|WARN|
# STATE|EVENT|INFO) on all 39 modules, producing ~1000 logcat lines/min
# on an idle device and flushing the ring buffers every ~12 minutes.
# Drop the INFO bit (-> 0x0f) on every module. The node resets when the
# driver reloads, which on this device only happens at boot.
# SELinux: /proc/net/wlan/dbgLevel is proc_net; init gets the write via
# sepolicy/dc1wlan.te.

on property:sys.boot_completed=1
    write /proc/net/wlan/dbgLevel 0x00:0x0f
    write /proc/net/wlan/dbgLevel 0x01:0x0f
    write /proc/net/wlan/dbgLevel 0x02:0x0f
    write /proc/net/wlan/dbgLevel 0x03:0x0f
    write /proc/net/wlan/dbgLevel 0x04:0x0f
    write /proc/net/wlan/dbgLevel 0x05:0x0f
    write /proc/net/wlan/dbgLevel 0x06:0x0f
    write /proc/net/wlan/dbgLevel 0x07:0x0f
    write /proc/net/wlan/dbgLevel 0x08:0x0f
    write /proc/net/wlan/dbgLevel 0x09:0x0f
    write /proc/net/wlan/dbgLevel 0x0a:0x0f
    write /proc/net/wlan/dbgLevel 0x0b:0x0f
    write /proc/net/wlan/dbgLevel 0x0c:0x0f
    write /proc/net/wlan/dbgLevel 0x0d:0x0f
    write /proc/net/wlan/dbgLevel 0x0e:0x0f
    write /proc/net/wlan/dbgLevel 0x0f:0x0f
    write /proc/net/wlan/dbgLevel 0x10:0x0f
    write /proc/net/wlan/dbgLevel 0x11:0x0f
    write /proc/net/wlan/dbgLevel 0x12:0x0f
    write /proc/net/wlan/dbgLevel 0x13:0x0f
    write /proc/net/wlan/dbgLevel 0x14:0x0f
    write /proc/net/wlan/dbgLevel 0x15:0x0f
    write /proc/net/wlan/dbgLevel 0x16:0x0f
    write /proc/net/wlan/dbgLevel 0x17:0x0f
    write /proc/net/wlan/dbgLevel 0x18:0x0f
    write /proc/net/wlan/dbgLevel 0x19:0x0f
    write /proc/net/wlan/dbgLevel 0x1a:0x0f
    write /proc/net/wlan/dbgLevel 0x1b:0x0f
    write /proc/net/wlan/dbgLevel 0x1c:0x0f
    write /proc/net/wlan/dbgLevel 0x1d:0x0f
    write /proc/net/wlan/dbgLevel 0x1e:0x0f
    write /proc/net/wlan/dbgLevel 0x1f:0x0f
    write /proc/net/wlan/dbgLevel 0x20:0x0f
    write /proc/net/wlan/dbgLevel 0x21:0x0f
    write /proc/net/wlan/dbgLevel 0x22:0x0f
    write /proc/net/wlan/dbgLevel 0x23:0x0f
    write /proc/net/wlan/dbgLevel 0x24:0x0f
    write /proc/net/wlan/dbgLevel 0x25:0x0f
    write /proc/net/wlan/dbgLevel 0x26:0x0f
