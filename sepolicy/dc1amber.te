#
# SELinux rules for the DC-1 amber frontlight.
#
# Ground truth (2026-08-22, live device): AmberControl runs in the
# `platform_app` domain (AOSP seapp_contexts maps privileged platform-signed
# apps to platform_app, NOT system_app). Grant exactly what the app needs:
#   - dir: traverse/read the LED class dirs for node discovery
#   - file: read max_brightness, write brightness
#

allow platform_app sysfs_leds:dir { search read open getattr };
allow platform_app sysfs_leds:file { getattr open read write };

# fallback: some panels expose the channel under /sys/class/backlight typed
# plain sysfs; cover that too so discovery/write are not blocked if the amber
# node lands outside the sysfs_leds label.
allow platform_app sysfs:file { getattr open read write };
allow platform_app sysfs:dir { search read open getattr };
